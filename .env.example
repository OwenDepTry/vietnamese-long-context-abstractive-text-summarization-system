# Copy thành .env (KHÔNG commit .env). docker compose tự đọc file này.
# Dự án không cần secret để chạy API/UI; nếu sau này cần (vd. HF_TOKEN), đặt ở .env, không ghi vào Dockerfile/compose.

# Thư mục trên máy chứa model đã merge (phase 2) và bản ONNX (phase 4), mount read-only vào /models.
#   Windows: dùng dấu / , ví dụ C:/vnsum-runs
MODEL_DIR=C:/vnsum-runs
MODEL_NAME=vit5-vnsum-merged

# Backend cho /summarize: onnx (mặc định) | pytorch ; bản ONNX: int8 (CPU) | fp32
VNSUM_BACKEND=onnx
VNSUM_ONNX_VARIANT=int8
# Backend cho /summarize/stream: same | pytorch
VNSUM_STREAM_BACKEND=same
VNSUM_LOG_LEVEL=INFO
